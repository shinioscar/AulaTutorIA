{
  "name": "aulatutor-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host localhost --port 4200 --ssl --ssl-cert ../../.cache/certs/localhost.pem --ssl-key ../../.cache/certs/localhost.key --proxy-config proxy.conf.json",
    "build": "ng build",
    "check": "tsc --noEmit -p tsconfig.app.json",
    "check:theme": "node ../../scripts/verify-theme.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.26",
    "@angular/cli": "21.2.26",
    "@angular/compiler-cli": "21.2.25",
    "typescript": "5.9.3"
  }
}
