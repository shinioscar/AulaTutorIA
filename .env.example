# Only fictitious/local development data. Copy to .env and choose a local password.
# .env is read by Compose; dotnet and Angular do not load it automatically.
POSTGRES_DB=aulatutor
POSTGRES_USER=aulatutor
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_PORT=15432
API_PORT=5080
# Iteration 0 supports Mock only. Other values must fail at startup.
AI_PROVIDER=Mock
