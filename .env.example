# Only fictitious/local development data. Copy to .env and choose a local password.
# .env is read by Compose; dotnet and Angular do not load it automatically.
POSTGRES_DB=aulatutor
POSTGRES_USER=aulatutor
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_PORT=15432
API_PORT=5080
API_HTTPS_PORT=7080
# Mock does not require any key. Selecting another provider requires explicit model/config.
AI_PROVIDER=Mock
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
AI_TIMEOUT_SECONDS=30
AI_MAX_CONCURRENCY=2
AI_MAX_RETRIES=0
AI_MAX_RETRY_DELAY_SECONDS=5
